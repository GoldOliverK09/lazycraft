{
	"schemaVersion": 1,
	"id": "lazycraft",
	"version": "${version}",
	"name": "LazyCraft",
	"description": "A recursive crafting planner that automatically resolves and crafts item dependencies.",
	"authors": [
		"GoldOliverK09"
	],
	"contact": {
		"sources": "https://github.com/GoldOliverK09/lazy-craft",
		"issues": "https://github.com/GoldOliverK09/lazy-craft/issues"
	},
	"license": "MIT",
	"icon": "assets/lazycraft/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"klumpler.lazycraft.LazyCraft"
		],
		"client": [
			"klumpler.lazycraft.client.LazyCraftClient"
		]
	},
	"mixins": [
		"lazycraft.mixins.json",
		{
			"config": "lazycraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"cloth-config": "*"
	}
}
