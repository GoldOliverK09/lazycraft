{
	"schemaVersion": 1,
	"id": "recursivecraft",
	"version": "${version}",
	"name": "Recursive Craft",
	"description": "A recursive crafting planner that automatically resolves and crafts item dependencies.",
	"authors": [
		"GoldOliverK09"
	],
	"contact": {
		"sources": "https://github.com/GoldOliverK09/recursivecraft",
		"issues": "https://github.com/GoldOliverK09/recursivecraft/issues"
	},
	"license": "MIT",
	"icon": "assets/recursivecraft/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"klumpler.recursivecraft.RecursiveCraft"
		],
		"client": [
			"klumpler.recursivecraft.client.RecursiveCraftClient"
		]
	},
	"mixins": [
		"recursivecraft.mixins.json",
		{
			"config": "recursivecraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}